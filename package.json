{
  "name": "marry-wanted",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c magenta,cyan \"vite --host\" \"node --watch server/index.mjs\"",
    "build": "tsc -b --noCheck && vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && node server/index.mjs",
    "deploy": "chcp 65001 >nul && powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "framer-motion": "^12.4.7",
    "howler": "^2.2.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/howler": "^2.2.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
